# Groq API Key (from https://console.groq.com/keys) — used when LLM_PROVIDER=groq.
# This is the PRIMARY provider now: Groq's free tier gives 14K+ requests/day and
# Qwen 27B on Groq is fast (~0.7s/call) with good summarization + Hindi.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
# Final-digest / Hindi model. Also used as the Groq fallback when the primary
# model rate-limits or fails (backup model on the same provider).
GROQ_MODEL_FINAL=qwen/qwen3.8-27b
GROQ_MODEL_BACKUP=qwen/qwen3.8-27b

# Google Gemini (primary LLM). Get a free key at https://aistudio.google.com/apikey
# LLM_PROVIDER switches the backend: "gemini" (default) or "groq".
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Flash-lite for the bulk scoring pass (fast/cheap), flash for the polished final digest.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_FINAL=gemini-flash-latest

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Personal Chat ID (to test --send mode)
TELEGRAM_CHAT_ID=your_chat_id_here

# MongoDB Connection String
# Local: mongodb://localhost:27017
# Cloud: mongodb+srv://user:***@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017

# Admin chat ID for failure alerts (optional). If unset, alerts go to the
# oldest subscriber so errors show up in Telegram without needing Render's
# paid-tier log history. Set to your own chat_id (after /starting the bot)
# to receive failure tracebacks directly.
ADMIN_CHAT_ID=
